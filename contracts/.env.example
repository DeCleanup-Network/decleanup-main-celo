# VERIFIER_ADDRESS=
# GRANT_VERIFIER_ADMIN_ROLE=YES
# SKIP_IMPACT_SUBMISSION_LINK=1
# SKIP_OWNERSHIP_TRANSFER=1
# RENOUNCE_DEPLOYER_ADMIN=YES
# SETUP_SUBMISSION_ADDRESS=
# SETUP_IMPACT_PRODUCT_NFT=
# SETUP_DCU_REWARD_MANAGER=

