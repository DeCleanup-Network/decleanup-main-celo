# =============================================================================
# DeCleanup — Hardhat / deploy scripts (contracts/)
# =============================================================================
# Copy to: contracts/.env  OR  repo root .env (hardhat loads project root)
# Never commit real private keys.
# =============================================================================

# Deployer wallet (funded with CELO)
PRIVATE_KEY=

# Celoscan / Etherscan V2 API key (unified key from etherscan.io)
# Used by: npx hardhat verify, contracts/scripts/verify-mainnet.sh
CELOSCAN_API_KEY=

# --- deploy-cdcu.ts ---
AUTHORIZED_SIGNER_ADDRESS=
# CLAIMVAULT_OWNER_MULTISIG=

# --- setup-roles.ts ---
ADMIN_SAFE=
