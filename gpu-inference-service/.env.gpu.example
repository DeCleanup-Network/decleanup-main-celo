# Copy to .env.gpu on the VPS (same directory as ecosystem.config.cjs).
# .env.gpu is gitignored — do not commit secrets.

SHARED_SECRET=use-same-value-as-frontend-GPU_SHARED_SECRET
# TACO litter weights — install with: ../../scripts/vps/install-taco-model.sh --local
MODEL_PATH=yolov8-taco.pt
MODEL_VERSION=yolov8-taco-n-100epochs-v1
HOST=127.0.0.1
PORT=8000
