{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/streak-reminders",
      "schedule": "0 */2 * * *"
    }
  ],
  "functions": {
    "src/app/api/ml-verification/verify/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/ml-verification/result/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ipfs/upload/route.ts": {
      "maxDuration": 180
    }
  }
}
