{
  "name": "decleanup-dapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:fast": "NEXT_DEV_ENABLE_WEBPACK_CACHE=1 NODE_OPTIONS=--no-deprecation NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:poll": "WATCHPACK_POLLING=true NODE_OPTIONS=--no-deprecation NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:clean": "rm -rf .next && NODE_OPTIONS=--no-deprecation NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2 --passWithNoTests",
    "generate:metadata": "node scripts/generateImpactMetadata.js",
    "check:claimvault-signer": "node scripts/check-claimvault-signer.mjs",
    "airdrop:sync-giveth-donors": "node scripts/sync-giveth-donor-allocations.mjs",
    "postinstall": "prisma generate",
    "db:push": "node scripts/with-env-local.mjs prisma db push",
    "db:apply-schema": "node scripts/apply-schema-pg.mjs",
    "db:apply-sql": "node scripts/apply-sql-migration.mjs",
    "db:check": "node scripts/check-auth-db.mjs",
    "db:pooler-url": "node scripts/print-pooler-database-url.mjs",
    "db:sql-file": "npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script 2>/dev/null > prisma/supabase-full-schema.sql && echo Wrote prisma/supabase-full-schema.sql",
    "db:local:up": "docker compose -f docker-compose.db.yml up -d",
    "db:local:push": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/decleanup?sslmode=disable prisma db push",
    "db:local:check": "DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/decleanup?sslmode=disable node scripts/check-auth-db.mjs",
    "db:studio": "prisma studio",
    "support:wallet-reset": "node scripts/reset-user-wallet.mjs"
  },
  "dependencies": {
    "@atproto/api": "^0.17.7",
    "@auth/prisma-adapter": "^2.11.2",
    "@celo/contractkit": "^10.0.2",
    "@hypercerts-org/lexicon": "^1.0.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@privy-io/react-auth": "^3.26.0",
    "@privy-io/wagmi": "^4.0.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@rainbow-me/rainbowkit": "^2.2.10",
    "@safe-global/api-kit": "^2.5.11",
    "@safe-global/protocol-kit": "^5.2.23",
    "@safe-global/types-kit": "^1.0.5",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.100.10",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "heic2any": "^0.0.4",
    "jose": "^6.2.3",
    "lucide-react": "^0.553.0",
    "next": "14.2.15",
    "next-auth": "^5.0.0-beta.25",
    "nodemailer": "^8.0.7",
    "permissionless": "^0.3.4",
    "pg": "^8.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-is": "^19.2.5",
    "recharts": "^3.8.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.3.1",
    "undici": "^5.29.0",
    "viem": "^2.49.3",
    "wagmi": "^2.19.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.19.30",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "form-data": "^4.0.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "minimatch": "^9.0.5",
    "node-fetch": "^2.7.0",
    "prisma": "^5.22.0",
    "supabase": "^2.76.11",
    "swagger-typescript-api": "^13.2.18",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@atproto/lexicon": "0.6.2"
  }
}
