# =============================================================================
# DeCleanup Rewards — environment template (frontend)
# =============================================================================
# Copy to:  frontend/.env.local
# Docs:     frontend/ENV_TEMPLATE.md  |  docs/DEVELOPERS.md
# Addresses: ../contracts/scripts/deployed_addresses.json
#
# Rules:
# - Comments on their own lines only (inline # after URLs can break RPC parsing).
# - NEXT_PUBLIC_* is baked at build time on Vercel — redeploy after changes.
# - Never commit .env.local or real secrets.
#
# Network: Celo MAINNET (chain 42220) — same as production dapp.decleanup.net.
# Local npm run dev still talks to mainnet RPC; wallet txs need real CELO on 42220.
#
# Quick start (wallet-only, ML off):
#   1. Copy this file to .env.local
#   2. Fill the MUST HAVE section below (addresses are mainnet — do not change)
#   3. Set NEXT_PUBLIC_AA_AUTH_ENABLED=false unless testing embedded login
#   4. Skip all OPTIONAL — * flow blocks unless you test that feature
# =============================================================================


# =============================================================================
# MUST HAVE — Celo mainnet (42220), minimum to run locally
# =============================================================================
# Covers: connect external wallet, submit cleanups, read on-chain dashboard.
# User pays their own CELO gas on mainnet. ML is off by default (no ML vars needed).


# --- Auth mode (pick one) ---
# false = wallet only (MetaMask / WalletConnect). Skip all OPTIONAL — Embedded login vars.
# true  = production path (Google / email + smart accounts). Also fill OPTIONAL — Embedded login.
NEXT_PUBLIC_AA_AUTH_ENABLED=false


# --- Celo mainnet (production) ---
NEXT_PUBLIC_CHAIN_ID=42220
NEXT_PUBLIC_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://celoscan.io
NEXT_PUBLIC_BLOCK_EXPLORER_NAME=CeloScan

# --- Smart contracts (mainnet — verify: contracts/scripts/deployed_addresses.json + verify-mainnet.sh) ---
NEXT_PUBLIC_SUBMISSION_CONTRACT=0x2f3654f0ad8117c41185c589dcd0ea22522fe5af
NEXT_PUBLIC_REWARD_DISTRIBUTOR_CONTRACT=0x1936270b066ebadedc2d84f4ce3b488729d1d638
NEXT_PUBLIC_IMPACT_PRODUCT_NFT=0x97fa526fba91f01b5a4e0f25c71751e474cb6f45
NEXT_PUBLIC_CDCU_TOKEN_ADDRESS=0x34d66e9552e9dc23a24eca13bb1f8f71f4b9bfc1
NEXT_PUBLIC_CLAIMVAULT_ADDRESS=0x4f69a1170c8799b5bc1587275b2e7da5a8406ff0

# --- App URLs (local dev) ---
NEXT_PUBLIC_WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- IPFS uploads (cleanup photos, impact reports) ---
# https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- External wallet (WalletConnect) ---
# https://cloud.walletconnect.com/ — app has a dev fallback if empty; set your own for prod-like testing
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Product flags (defaults used in production) ---
NEXT_PUBLIC_ATOMIC_CONTRACT_TX=1
NEXT_PUBLIC_ENABLE_SUBMISSION_BONUS_CLAIM=1
NEXT_PUBLIC_HYPERCERTS_NETWORK=celo


# =============================================================================
# OPTIONAL — Embedded login + smart accounts
# =============================================================================
# Only when NEXT_PUBLIC_AA_AUTH_ENABLED=true
# Flow: Google / email sign-in, Safe smart account, gasless submit (Pimlico), passkeys

# AUTH_SECRET=
# DATABASE_URL=
# DIRECT_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM=DeCleanup <onboarding@resend.dev>
# AUTH_URL=https://dapp.decleanup.net
# EMAIL_SERVER=smtp://resend:re_YOUR_KEY@smtp.resend.com:587
# PIMLICO_API_KEY=
# NEXT_PUBLIC_PIMLICO_API_KEY=
# WALLET_ENCRYPTION_KEY=
# NEXT_PUBLIC_WEBAUTHN_RP_ID=dapp.decleanup.net
# NEXT_PUBLIC_WEBAUTHN_ORIGIN=https://dapp.decleanup.net
# NEXT_PUBLIC_WEBAUTHN_RP_NAME=DeCleanup Rewards
# NEXT_PUBLIC_APP_HOST=dapp.decleanup.net


# =============================================================================
# OPTIONAL — $cDCU claim + past-contributor airdrop
# =============================================================================
# Flow: user claims $cDCU or airdrop via ClaimVault (server signs EIP-712)
# Without CLAIM_VAULT_AUTHORIZED_SIGNER_PRIVATE_KEY: eligibility UI works; claim tx fails.

# CLAIM_VAULT_AUTHORIZED_SIGNER_PRIVATE_KEY=
# CDCU_CLAIM_LOGS_FROM_BLOCK=
# CLAIM_VAULT_UNLOCK_SECRET=
# CLAIM_VAULT_ISSUED_STORE_PATH=./data/cdcu-issued.json
# AIRDROP_ISSUED_STORE_PATH=./data/airdrop-issued.json
# CDCU_MULTIPLIER_START_DATE=2026-01-01T00:00:00.000Z


# =============================================================================
# OPTIONAL — Supabase-backed features
# =============================================================================
# Flow: verifier applications, hypercert request queue, impact portfolios,
#       airdrop/claim pending state, cleanup feed for public API
# Apply: frontend/supabase/migrations/

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# OPTIONAL — Public impact API (decleanup.net feed)
# =============================================================================
# Flow: POST /api/impact/sync, landing "Recent Verifications" table

# IMPACT_SYNC_SECRET=
# IMPACT_REVERSE_GEOCODING_ENABLED=false
# NOMINATIM_USER_AGENT=DeCleanupRewards/1.0 (https://dapp.decleanup.net; contact: you@example.com)
# NOMINATIM_ACCEPT_LANGUAGE=en
# IMPACT_FEED_LEGACY_SUBMISSION_CONTRACT=


# =============================================================================
# OPTIONAL — Hypercerts (AT Protocol / Hyperscan)
# =============================================================================
# Flow: /hypercerts request → verifier approve → auto-publish to AT Protocol

# HYPERCERTS_AT_ENABLED=true
# NEXT_PUBLIC_HYPERCERTS_AT_ENABLED=true
# HYPERCERTS_ATPROTO_HANDLE=decleanup.bsky.social
# ATPROTO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# HYPERCERTS_ATPROTO_DID=did:plc:...
# Optional login resolver (auto: bsky.social for Bluesky handles, certified.one for *.certified.one)
# HYPERCERTS_ATPROTO_LOGIN_SERVICE=https://bsky.social
# Staging: https://dev.certified.app

# NEXT_PUBLIC_HYPERCERT_RELAXED_ELIGIBILITY=true


# =============================================================================
# OPTIONAL — ML photo pre-screening (off by default)
# =============================================================================
# Flow: automated checks after cleanup submit. Skip entire block if ML is off.
# Server ML runs only when ML_VERIFICATION_ENABLED=true (unset = off).

# NEXT_PUBLIC_ML_VERIFICATION_ENABLED=false
# ML_VERIFICATION_ENABLED=true
# GPU_INFERENCE_SERVICE_URL=http://127.0.0.1:8000
# GPU_INFERENCE_PATH=/verify
# GPU_SHARED_SECRET=
# UPLOAD_DIR=/var/www/decleanup/uploads
# PUBLIC_URL_BASE=https://dapp.decleanup.net
# HEIF_CONVERT_BIN=heif-convert
# ML_BACKEND_ORIGIN=https://ml.decleanup.net
# ML_PROXY_SHARED_SECRET=
# ML_BACKEND_PROXY_TIMEOUT_MS=120000
# DMRV_MODEL_PROVIDER=mock
# DMRV_MODEL_NAME=FathomNet/trash-detector
# HUGGINGFACE_API_KEY=


# =============================================================================
# OPTIONAL — Telegram verifier alerts
# =============================================================================
# See docs/TELEGRAM_VERIFIER_BOT.md

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_VERIFIER_CHAT_ID=


# =============================================================================
# OPTIONAL — SEO, branding, assets
# =============================================================================

# GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_APP_ICON_URL=https://dapp.decleanup.net/icon.png
# NEXT_PUBLIC_IMPACT_IMAGES_CID=
# NEXT_PUBLIC_IMPACT_METADATA_CID=
# NEXT_PUBLIC_DCU_TOKEN_CONTRACT=


# =============================================================================
# OPTIONAL — Integrations & ops
# =============================================================================

# Pinata key pair (alternative to PINATA_JWT)
# PINATA_API_KEY=
# PINATA_SECRET_KEY=

# ENS reverse lookup
# ETHEREUM_RPC_URL=
# NEXT_PUBLIC_ETHEREUM_RPC_URL=

# Location helper API
# NEXT_PUBLIC_BIGDATACLOUD_API_KEY=

# Cross-chain impact stats (internal only)
# IMPACT_STATS_CELO_RPC_URL=
# IMPACT_STATS_CELO_SUBMISSION_CONTRACT=
# IMPACT_STATS_CELO_CDCU_CONTRACT=
# IMPACT_STATS_CELO_FROM_BLOCK=
# IMPACT_STATS_BASE_RPC_URL=
# IMPACT_STATS_BASE_SUBMISSION_CONTRACT=
# IMPACT_STATS_BASE_FROM_BLOCK=

# Legacy auth (usually off)
# NEXT_PUBLIC_PRIVY_APP_ID=

# Celo Sepolia testnet (not used for this handoff — mainnet only)
# NEXT_PUBLIC_CHAIN_ID=11142220
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://celo-sepolia.blockscout.com
# Sepolia contracts differ — see contracts/scripts/cdcu-deployed.json (do not copy mainnet addresses)

# Server RPC overrides
# CELO_SEPOLIA_RPC_URL=
# CELO_RPC_URL=

# Prisma driver
# PRISMA_USE_PG_DRIVER=1

# Local dev tooling only (not Vercel)
# NEXT_DEV_ENABLE_WEBPACK_CACHE=1
# WATCHPACK_POLLING=true
