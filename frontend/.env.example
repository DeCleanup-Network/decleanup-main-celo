# Copy to `.env.local` for local dev / VPS. Values are examples only.

# --- Production reward policy (align with on-chain ImpactProductNFT + Submission) ---
# After Claim level (mint/upgrade), call Submission.claimSubmissionBonusRewards. Default in app is ON; set to 0 to disable.
# NEXT_PUBLIC_ENABLE_SUBMISSION_BONUS_CLAIM=0

# On-chain: also require ImpactProductNFT.impactClaimRewardsEnabled=true (owner) for per-level DCU via rewardImpactProductClaim.

# --- ML / GPU verification (set off for mainnet soft-launch) ---
# Server: when not exactly `true`, POST/GET skip GPU and do not forward to ml host.
# ML_VERIFICATION_ENABLED=false
# Client bundle: skip calling verify after submit (must redeploy after change).
# NEXT_PUBLIC_ML_VERIFICATION_ENABLED=false

# --- ML verification file storage (VPS) ---
# Absolute path; must not be a typo like UPLOAD_DIR= (empty). PM2 ecosystem defaults to /var/www/decleanup/uploads.
# UPLOAD_DIR=/var/www/decleanup/uploads

# --- Vercel → ml.decleanup.net proxy (Option A) ---
# Vercel (dapp.decleanup.net): set origin + secret so server routes forward to the ML host.
# ML_BACKEND_ORIGIN=https://ml.decleanup.net
# ML_PROXY_SHARED_SECRET=use-a-long-random-string-same-on-both-vercel-and-vps
# Optional: ML_BACKEND_PROXY_TIMEOUT_MS=120000
#
# VPS (ml.decleanup.net): set the SAME ML_PROXY_SHARED_SECRET so only Vercel (or anyone with the header) can call ML APIs.
# Do NOT set ML_BACKEND_ORIGIN on the VPS (leave empty so this node runs GPU + disk locally).
