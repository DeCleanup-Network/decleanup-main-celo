generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String                     @id @default(cuid())
  name                 String?
  email                String?                    @unique
  emailVerified        DateTime?
  image                String?
  accounts             Account[]
  sessions             Session[]
  wallet               UserWallet?
  passkeyCredentials   PasskeyCredential[]
  passkeyUnlock        PasskeyUnlockSecret?
  webAuthnChallenges   WebAuthnChallenge[]
  notifications        UserNotification[]
  pushSubscriptions    PushSubscription[]
  contributorWelcomeGrants ContributorWelcomeGrant[]
  /// Prefer email/push for reward & security events (default on).
  notifyEmail          Boolean                    @default(true)
  notifyPush           Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Non-custodial: server stores opaque client-encrypted blob only (never decrypted server-side).
model UserWallet {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address             String   @unique
  encryptedBlob       Json
  smartAccountAddress String
  chainId             Int
  walletVersion       Int      @default(2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// WebAuthn passkey for wallet unlock (not blockchain signing).
model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String   @unique
  publicKey    String   @db.Text
  counter      Int      @default(0)
  transports   Json?
  deviceType   String?
  backedUp     Boolean?
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Server-side secret used to issue post-passkey unlock material (never the wallet private key).
model PasskeyUnlockSecret {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Short-lived WebAuthn challenges (registration / authentication).
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// In-app notification inbox (email/push fan-out via NotificationService).
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  href      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
}

/// Web Push subscription (VAPID). Unique endpoint across users.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Idempotent 10 DCU welcome when a registered user is listed as a contributor.
model ContributorWelcomeGrant {
  id                String   @id @default(cuid())
  contributorUserId String
  contributor       User     @relation(fields: [contributorUserId], references: [id], onDelete: Cascade)
  submissionId      String
  amountDcu         Int      @default(10)
  /// recorded | pending_ops | distributed
  status            String   @default("recorded")
  grantedAt         DateTime @default(now())

  @@unique([contributorUserId, submissionId])
  @@index([submissionId])
}

/// Contributors listed on a cleanup (matched after verification).
model CleanupContributorEntry {
  id           String   @id @default(cuid())
  submissionId String
  identifier   String
  normalized   String
  /// email | address | ens
  kind         String
  createdAt    DateTime @default(now())

  @@unique([submissionId, normalized])
  @@index([submissionId])
}
